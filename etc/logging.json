{
    "version": 1,
    "disable_existing_loggers": false,
    "filters": {
      "request_id": {
        "()": "asgi_correlation_id.CorrelationIdFilter",
        "uuid_length": 32,
        "default_value": "-"
      },
      "skip_access_logs": {
        "()": "oec.logging.AccessLogFilter",
        "skip_prefix": ["/ui/", "/static/"]
      }
    },
    "formatters": {
      "generic": {
        "()": "logging.Formatter",
        "fmt": "[%(levelname)s] %(message)s",
        "datefmt": "[%Y-%m-%d %H:%M:%S]"
      },
      "detailed": {
        "format": "%(correlation_id)s: %(asctime)s - %(name)s - %(levelname)s - %(message)s"
      },
      "json": {
        "()": "pythonjsonlogger.orjson.OrjsonFormatter",
        "fmt": "%(name)s %(levelname)s %(message)s %(args)s",
        "rename_fields": {
          "name": "module",
          "levelname": "level",
          "correlation_id": "request_id"
        },
        "timestamp": false
      }
    },
    "handlers": {
      "console": {
        "filters": ["skip_access_logs"],
        "formatter": "generic",
        "class": "logging.StreamHandler",
        "stream": "ext://sys.stdout"
      },
      "console-json": {
        "filters": ["request_id", "skip_access_logs"],
        "formatter": "json",
        "class": "logging.StreamHandler",
        "stream": "ext://sys.stdout"
      },
      "file": {
        "filters": ["request_id"],
        "formatter": "detailed",
        "class": "logging.handlers.RotatingFileHandler",
        "filename": "/tmp/logiclayer.log",
        "maxBytes": 5000,
        "backupCount": 3
      }
    },
    "loggers": {
      "tesseract_olap": {
        "level": "DEBUG",
        "handlers": ["console-json", "file"],
        "propagate": false
      },
      "tesseract_olap.schema": {
        "level": "INFO",
        "handlers": ["console"],
        "propagate": false
      },
      "clickhouse_driver": {
        "level": "WARNING",
        "handlers": [],
        "propagate": false
      },
      "clickhouse_driver.connection": {
        "level": "DEBUG",
        "handlers": ["file"],
        "propagate": false
      },
      "uvicorn.access": {
        "level": "INFO",
        "handlers": ["console-json"],
        "propagate": false
      }
    },
    "root": {
      "level": "WARNING",
      "handlers": ["console-json"]
    }
  }
